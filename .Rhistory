# Generating a dataset with heavy tails using t-distribution
set.seed(123) # for reproducibility
data <- tibble(value = rt(10000, df = 3))
# Histogram of raw values
p1 <- ggplot(data, aes(x = value)) +
geom_histogram(bins = 50, fill = "blue", alpha = 0.7) +
ggtitle("Histogram of Raw Values") +
theme_minimal()
# Winsorizing the data at 1% level
data_winsorized <- tibble(value = winsorize(data$value, probs = c(0.01, 0.99)))
?winsorize
