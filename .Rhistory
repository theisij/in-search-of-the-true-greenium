# Simulate a time series
set.seed(123)
ts_data <- arima.sim(list(order = c(1, 0, 0), ar = 0.6), n = 100)
# Fit an AR(2) model to compute the second PACF
ar_model <- ar(ts_data, aic = FALSE, order.max = 2)
# Extract the second partial autocorrelation
second_pacf <- ar_model$ar[2]
second_pacf
pacf(ts_data, main = "PACF of AR(1)")
test <- pacf(ts_data, main = "PACF of AR(1)")
test$acf[1:3]
pacf_data <- pacf(ts_data, main = "PACF of AR(1)")
pacf_data
pacf_data
ar(ts_data, aic = FALSE, order.max = 2)$ar[2]
# Compute the PACF -------------------------------------------------------------
# Fit an AR(1) model to compute the second PACF
ar(ts_data, aic = FALSE, order.max = 1)$ar[1]
# Fit an AR(2) model to compute the second PACF
ar(ts_data, aic = FALSE, order.max = 2)$ar[2]
pacf_data
# Compute the PACF -------------------------------------------------------------
# Fit an AR(1) model to compute the first PACF
ar(ts_data, aic = FALSE, order.max = 1)$ar[1]
# Fit an AR(2) model to compute the second PACF
ar(ts_data, aic = FALSE, order.max = 2)$ar[2]
# Fit an AR(3) model to compute the third PACF
ar(ts_data, aic = FALSE, order.max = 3)$ar[3]
