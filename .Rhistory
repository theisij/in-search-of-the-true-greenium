library(tidyverse)
# Layout Settings ---------------
theme_set(theme_bw())
colours_theme <- c("#0C6291", "#A63446", RColorBrewer::brewer.pal(8, "Dark2"),
"darkslategrey", "blue3", "red3", "purple2", "yellow2", "aquamarine",
"grey", "salmon", "antiquewhite", "chartreuse")
scale_colour_discrete <- function(...) {
scale_colour_manual(..., values = colours_theme)
}
scale_fill_discrete <- function(...) {
scale_fill_manual(..., values = colours_theme)
}
# Money ----------------
# Input money!!
data <- tribble(
~"Team", ~"Name", ~"Money",
1, "Koch & Sparrevohn", 10000,
2, "Eirik & Dilling", 10000,
3, "Sondre & Micki", 10000,
4, "Jesper & Kjetil", 10000,
5, "Emil & Per", 10000,
6, "Søren & Mads", 10000,
7, "Gerup & Sindre", 10000,
8, "Rame & Manu", 900
) |>
mutate(Prob = Money/sum(Money))
# Overview ------------
plot1 <- data |>
ggplot(aes(reorder(Name, Team), Prob)) +
geom_col(fill = "skyblue") +
labs(y = "Probability of winning each Underberg", title = "Probability of winning each Underberg") +
scale_y_continuous(labels = scales::percent) +
geom_label(aes(label = scales::percent(Prob))) +
theme(
axis.title.x = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
text = element_text(size = 15)
)
plot2 <- data |>
mutate(exp_und = Prob * 20) |>
ggplot(aes(reorder(Name, Team), exp_und)) +
geom_col(fill = "skyblue") +
labs(y = "Expected Underbergs", title = "Expected Underberg winnings") +
geom_label(aes(label = round(exp_und, 2))) +
theme(
axis.title.x = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
text = element_text(size = 15)
)
cowplot::plot_grid(plot1+theme(axis.text.x = element_blank()), plot2, nrow = 2, rel_heights = c(0.45, 0.55), align = "l")
# Draw -----------------
set.seed(1)
data <- data |>
mutate(Underberg = 0)
Sys.sleep(10)
for (i in 1:20) {
# Draw team
team <- sample(1:8, 1, prob = data$Prob)
data <- data |>
mutate(Underberg = Underberg + if_else(Team == team, 1, 0))
print(data |>
ggplot(aes(reorder(Name, Team), Underberg)) +
geom_col(fill = "skyblue") +
labs(y = "Underberg", title = paste0("Underberg ", i, " (of 20) won by ", data |> filter(Team==team) |> pull(Name))) +
geom_label(aes(label = Underberg)) +
coord_cartesian(ylim=c(0, NA)) +
geom_hline(yintercept=0) +
theme(
axis.title.x = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
text = element_text(size = 20)
))
# Make system wait for 5 seconnds
Sys.sleep(3)
}
